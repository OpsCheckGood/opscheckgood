---
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
  /**
   * Name of the tool on this page. The site is Ops Check Good; a tool such as
   * Bullet Bench sits inside it, so the header shows both. Omitted on the home
   * page, which is the site itself.
   */
  brand?: string;
  /** The tool's own tagline, shown beside its name. */
  tagline?: string;
}

const {
  title,
  description = 'Free, offline tools for Airmen. Total force, enlisted and officer.',
  brand,
  tagline,
} = Astro.props;

const home = import.meta.env.BASE_URL;
const base = home.replace(/\/$/, '');
const year = new Date().getFullYear();

// Tools listed in the footer, alongside the reference pages a reader might
// want. Derived from routes that actually exist so nothing here 404s.
const footerTools = [
  { label: 'First Sergeant Toolkit', href: `${base}/first-sergeant/` },
  { label: 'Bullet Bench', href: `${base}/tools/bullet-bench/` },
  { label: 'PT Calculator', href: `${base}/tools/pt-calculator/` },
  { label: 'BTZ Calculator', href: `${base}/tools/btz-calculator/` },
  { label: 'MFR Generator', href: `${base}/tools/mfr/` },
];

// External references, for checking the shipped data against its source. Plain
// links a reader chooses to follow; the page never requests them, so hard
// constraint 1 is untouched.
const footerReference = [
  { label: 'AFPC Acronyms', href: 'https://www.afpc.af.mil/Career-Management/Acronyms/' },
  { label: 'AF e-Publishing', href: 'https://www.e-publishing.af.mil/' },
];

// Site-level navigation only. A tool's own pages -- Bullet Bench's abbreviation
// lists and thesaurus, say -- belong to that tool and are reached from inside
// it, not from here. Unbuilt entries are named but not linked: a dead link is
// worse than an honest "not yet".
// The phone tab bar. Five is the most a tab bar can hold before the labels
// stop being readable, so these are the tools people actually open; the rest
// stay reachable from the Tools screen.
const tabs = [
  { label: 'Tools', href: home },
  { label: 'Bullet', href: `${base}/tools/bullet-bench/` },
  { label: 'PT', href: `${base}/tools/pt-calculator/` },
  { label: 'BTZ', href: `${base}/tools/btz-calculator/` },
  { label: 'MFR', href: `${base}/tools/mfr/` },
];

// Which tab is the page we are on, matched longest-first so /tools/mfr/ does
// not also light up Tools.
const path = Astro.url.pathname.replace(/\/+$/, '') || '/';
const activeTab =
  [...tabs]
    .sort((a, b) => b.href.length - a.href.length)
    .find((t) => path === t.href.replace(/\/+$/, ''))?.href ?? null;

const nav = [
  { label: 'Tools', href: home, ready: true },
  { label: 'First Sergeant', href: `${home.replace(/\/$/, '')}/first-sergeant/`, ready: true },
  { label: 'Settings', href: `${base}/settings/`, ready: true },
];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <!--
      Colours the phone's own chrome to match the page, which is most of what
      separates "a website in a browser" from "an app". Two values so the bar
      follows the theme.
    -->
    <meta name="theme-color" content="#f1f4f8" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#0a0b0c" media="(prefers-color-scheme: dark)" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-status-bar-style" content="default" />
    <meta name="apple-mobile-web-app-title" content="Ops Check Good" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <!-- No favicon link, no web fonts, no analytics: hard constraint 1. -->
    <!--
      Runs before first paint so a stored theme choice is applied to <html>
      before anything is drawn. Inline and synchronous on purpose: an external
      or deferred script would paint the wrong theme first and then correct it.
    -->
    <script is:inline>
      (function () {
        try {
          var stored = localStorage.getItem('ocg.theme');
          if (stored === 'light' || stored === 'dark') {
            document.documentElement.setAttribute('data-theme', stored);
          }
        } catch (e) {
          /* Blocked storage: fall through to the default. */
        }
      })();
    </script>
  </head>
  <body>
    <a
      href="#main"
      class="sr-only focus:not-sr-only absolute left-2 top-2 z-10 px-3 py-2"
      style="background: var(--panel); border: 1px solid var(--rule-strong);"
    >
      Skip to content
    </a>

    <header
      class="app-bar flex flex-wrap items-center gap-x-6 gap-y-2 border-b px-3 sm:px-6 py-3 sm:py-4"
      style="border-color: var(--rule);"
    >
      {/*
        On a tool page the tool is the heading and the site is the label above
        it, rather than both competing on one line at the same size. That is
        the whole hierarchy fix in miniature: one thing leads.
      */}
      <div class="min-w-0">
        <a
          href={home}
          class="no-underline block"
          style={
            brand
              ? 'font-size: 10.5px; font-weight: 600; letter-spacing: 0.16em; text-transform: uppercase; color: var(--ink-faint);'
              : 'font-size: 17px; font-weight: 700; letter-spacing: 0.16em; color: var(--ink);'
          }
        >
          OPS CHECK GOOD
        </a>
        {
          brand && (
            <div class="flex flex-wrap items-baseline gap-x-3 gap-y-0.5">
              <span
                style="font-size: var(--text-h1); font-weight: 700; letter-spacing: -0.01em; color: var(--ink); line-height: 1.15;"
              >
                {brand}
              </span>
              {tagline && <span class="util desktop-only">{tagline}</span>}
            </div>
          )
        }
      </div>

      <nav class="ml-auto flex flex-wrap items-center gap-x-7 gap-y-2">
        <span class="desktop-only contents">
        {
          nav.map((item) =>
            item.ready ? (
              <a
                href={item.href}
                class="util no-underline"
                style="color: var(--ink-muted); letter-spacing: 0.13em;"
              >
                {item.label}
              </a>
            ) : (
              <span
                class="util"
                title="Not built yet"
                style="letter-spacing: 0.13em; opacity: 0.5;"
              >
                {item.label}
              </span>
            ),
          )
        }
        </span>
        <button
          id="theme-toggle"
          type="button"
          class="util border px-2 py-1"
          style="background: var(--panel); border-color: var(--rule-strong); letter-spacing: 0.13em;"
        >
          Theme
        </button>
      </nav>
    </header>

    <main id="main" class="app-shell">
      <slot />
    </main>

    <nav class="tabbar" aria-label="Tools">
      {
        tabs.map((tab) => (
          <a href={tab.href} aria-current={activeTab === tab.href ? 'page' : undefined}>
            {tab.label}
          </a>
        ))
      }
    </nav>

    <footer class="mt-10 border-t" style="border-color: var(--rule);">
      <div class="desktop-only mx-auto grid max-w-[1560px] gap-8 px-3 sm:px-6 py-8 sm:grid-cols-2 lg:grid-cols-4">
        <div class="lg:col-span-2">
          <a
            href={home}
            class="no-underline"
            style="font-size: 14px; font-weight: 700; letter-spacing: 0.16em; color: var(--ink);"
          >
            OPS CHECK GOOD
          </a>
          <p class="body m-0 mt-2 max-w-[46ch]">
            Free tools for Airmen. Total force, enlisted and officer.
          </p>
        </div>

        <nav aria-label="Tools">
          <h2 class="util m-0">Tools</h2>
          <ul class="m-0 mt-3 list-none space-y-2 p-0">
            {
              footerTools.map((item) => (
                <li>
                  <a
                    href={item.href}
                    class="no-underline"
                    style="font-size: var(--text-small); color: var(--ink-muted);"
                  >
                    {item.label}
                  </a>
                </li>
              ))
            }
          </ul>
        </nav>


        <nav aria-label="Reference">
          <h2 class="util m-0">Reference</h2>
          <ul class="m-0 mt-3 list-none space-y-2 p-0">
            {
              footerReference.map((item) => (
                <li>
                  <a
                    href={item.href}
                    target="_blank"
                    rel="noreferrer noopener"
                    class="no-underline"
                    style="font-size: var(--text-small); color: var(--ink-muted);"
                  >
                    {item.label} <span aria-hidden style="color: var(--ink-faint);">↗</span>
                  </a>
                </li>
              ))
            }
          </ul>
        </nav>
      </div>

      <div class="border-t" style="border-color: var(--rule);">
        <div class="mx-auto flex max-w-[1560px] flex-wrap items-center gap-x-6 gap-y-2 px-3 sm:px-6 py-4">
          <p class="util m-0" style="letter-spacing: 0.08em;">
            &copy; {year} Ops Check Good
          </p>
          <p class="m-0 ml-auto" style="font-size: var(--text-small); color: var(--ink-muted);">
            Built for Airmen, by Airmen.
          </p>
        </div>
      </div>

      <div class="border-t" style="border-color: var(--rule);">
        <p
          class="mx-auto m-0 max-w-[70ch] px-3 sm:px-6 py-4 leading-relaxed"
          style="font-size: var(--text-micro); color: var(--ink-faint);"
        >
          Unofficial personal project. Not affiliated with, endorsed by, or produced by the
          United States Air Force or the Department of Defense. Official guidance governs;
          check current instructions and your chain of command before relying on anything here.
        </p>
      </div>
    </footer>

    <script is:inline>
      (function () {
        var button = document.getElementById('theme-toggle');
        if (!button) return;
        var root = document.documentElement;

        function current() {
          // Light is the default, so an absent attribute means light.
          return root.getAttribute('data-theme') === 'dark' ? 'dark' : 'light';
        }
        function label() {
          // Names the action, not the state: pressing it gives you the other one.
          var next = current() === 'dark' ? 'Light' : 'Dark';
          button.textContent = next;
          button.setAttribute('aria-label', 'Switch to ' + next.toLowerCase() + ' mode');
        }

        button.addEventListener('click', function () {
          var next = current() === 'dark' ? 'light' : 'dark';
          root.setAttribute('data-theme', next);
          try {
            localStorage.setItem('ocg.theme', next);
          } catch (e) {
            /* Choice applies for this page view only. */
          }
          label();
        });

        label();
      })();
    </script>
  </body>
</html>
