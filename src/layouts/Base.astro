---
import '../styles/global.css';
import { tools, firstSergeant, settings, home } from '../lib/site-nav';

interface Props {
  title: string;
  description?: string;
  /**
   * Name of the tool on this page. The site is Ops Check Good; a tool such as
   * Bullet Bench sits inside it, so the header shows both. Omitted on the home
   * page, which is the site itself.
   */
  brand?: string;
  /** The tool's own tagline, shown beside its name. */
  tagline?: string;
}

const {
  title,
  /*
   * Deliberately descriptive rather than punchy.
   *
   * "Tools for Airmen." is the right thing to show a person and the wrong
   * thing to show a URL categoriser: it names no subject, so a service with no
   * entry for this domain has nothing to file it under and leaves it
   * Uncategorised -- which is what a DoD filter blocks by default. This says
   * what the site is for in terms a classifier can act on.
   */
  description = 'Free administrative and readiness tools for United States Air Force personnel: ' +
    'physical fitness assessment scoring, performance statement and award bullet formatting, ' +
    'official memorandum and letter of counseling generation, decoration citation drafting, ' +
    'below-the-zone promotion dates, promotion ceremony scripts, ' +
    'and a First Sergeant helping-agency directory. Runs entirely in the browser.',
  brand,
  tagline,
} = Astro.props;

const year = new Date().getFullYear();

// Everything below is derived from the one tool catalogue in lib/site-nav, so
// a tool added there appears in the header menu, the footer and the tab bar
// without a second edit.

// The header's Tools menu. First Sergeant is a collection with its own landing
// page, so it sits at the end of the list rather than inside it.
const menuTools = [...tools, firstSergeant].filter((tool) => tool.ready);

// Site-level pages. On a phone the header nav is hidden and the tab bar has no
// room for these, so the footer is the only way to reach Settings: it is not
// decoration.
const footerSite = [
  { name: 'Tools', href: home },
  { name: firstSergeant.name, href: firstSergeant.href },
  { name: settings.name, href: settings.href },
];



// The phone tab bar. Five is the most a tab bar can hold before the labels
// stop being readable, so these are the tools people actually open; the rest
// stay reachable from the Tools screen and the footer.
const tabs = [
  { label: 'Tools', href: home },
  ...tools.filter((tool) => tool.ready).map((tool) => ({ label: tool.short, href: tool.href })),
].slice(0, 5);

// Which tab is the page we are on, matched longest-first so /tools/mfr/ does
// not also light up Tools.
const path = Astro.url.pathname.replace(/\/+$/, '') || '/';
const activeTab =
  [...tabs]
    .sort((a, b) => b.href.length - a.href.length)
    .find((t) => path === t.href.replace(/\/+$/, ''))?.href ?? null;

// Site-level navigation only. A tool's own pages -- Bullet Bench's abbreviation
// lists and thesaurus, say -- belong to that tool and are reached from inside
// it. Tools carries a menu; the rest are plain links.
const nav = [
  { label: 'Tools', href: home, ready: true, menu: menuTools },
  { label: 'First Sergeant', href: firstSergeant.href, ready: true, menu: null },
  { label: 'Settings', href: settings.href, ready: true, menu: null },
];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <!--
      Colours the phone's own chrome to match the page, which is most of what
      separates "a website in a browser" from "an app". Two values so the bar
      follows the theme.
    -->
    <meta name="theme-color" content="#f2f1ed" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#121314" media="(prefers-color-scheme: dark)" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-status-bar-style" content="default" />
    <meta name="apple-mobile-web-app-title" content="Ops Check Good" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <!-- No favicon link, no web fonts, no analytics: hard constraint 1. -->
    <!--
      Runs before first paint so a stored theme choice is applied to <html>
      before anything is drawn. Inline and synchronous on purpose: an external
      or deferred script would paint the wrong theme first and then correct it.
    -->
    <script is:inline>
      (function () {
        try {
          var stored = localStorage.getItem('ocg.theme');
          if (stored === 'light' || stored === 'dark') {
            document.documentElement.setAttribute('data-theme', stored);
          }
        } catch (e) {
          /* Blocked storage: fall through to the default. */
        }
      })();
    </script>
  </head>
  <body>
    <a
      href="#main"
      class="sr-only focus:not-sr-only absolute left-2 top-2 z-10 px-3 py-2"
      style="background: var(--panel); border: 1px solid var(--rule-strong);"
    >
      Skip to content
    </a>

    <header
      class="app-bar flex flex-wrap items-center gap-x-6 gap-y-2 border-b px-4 sm:px-8 py-4 sm:py-5"
      style="border-color: var(--rule);"
    >
      {/*
        On a tool page the tool is the heading and the site is the label above
        it, rather than both competing on one line at the same size. On the
        home page the site is the only thing here.
      */}
      <div class="min-w-0">
        {
          brand ? (
            <>
              <a href={home} class="util no-underline block">
                Ops Check Good
              </a>
              <div class="mt-1 flex flex-wrap items-baseline gap-x-3 gap-y-0.5">
                <span class="wordmark" style="font-size: 24px;">{brand}</span>
                {tagline && <span class="util desktop-only">{tagline}</span>}
              </div>
            </>
          ) : (
            <a href={home} class="wordmark no-underline block" style="font-size: 24px;">
              Ops Check Good
            </a>
          )
        }
      </div>

      <nav class="ml-auto flex flex-wrap items-center gap-x-8 gap-y-2" aria-label="Site">
        <span class="desktop-only contents">
        {
          nav.map((item) =>
            item.menu ? (
              /*
                The label stays a real link to the tools index, so a click or a
                keyboard Enter goes somewhere sensible; the panel is an
                additional shortcut, not the only route. Opening on hover and on
                focus-within keeps it reachable without a pointer, and costs no
                JavaScript.
              */
              <div class="nav-menu">
                <a href={item.href} class="nav-link nav-menu-label">
                  {item.label}
                </a>
                <div class="nav-menu-panel">
                  <ul class="nav-menu-list">
                    {item.menu.map((tool) => (
                      <li>
                        <a href={tool.href} class="no-underline">
                          <span class="nav-menu-name">{tool.name}</span>
                          <span class="nav-menu-note">{tool.tagline}</span>
                        </a>
                      </li>
                    ))}
                  </ul>
                </div>
              </div>
            ) : (
              <a href={item.href} class="nav-link">
                {item.label}
              </a>
            ),
          )
        }
        </span>
        <button id="theme-toggle" type="button" class="theme-toggle" aria-label="Switch to dark mode">
          <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
            <path data-icon="moon" d="M20.5 14.3A8.5 8.5 0 0 1 9.7 3.5a8.5 8.5 0 1 0 10.8 10.8z" />
            <g data-icon="sun" style="display: none;">
              <circle cx="12" cy="12" r="4.2" />
              <path d="M12 2.5v3M12 18.5v3M2.5 12h3M18.5 12h3M5.3 5.3l2.1 2.1M16.6 16.6l2.1 2.1M5.3 18.7l2.1-2.1M16.6 7.4l2.1-2.1" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" fill="none" />
            </g>
          </svg>
        </button>
      </nav>
    </header>

    <main id="main" class="app-shell">
      <slot />
    </main>

    <nav class="tabbar" aria-label="Tools">
      {
        tabs.map((tab) => (
          <a href={tab.href} aria-current={activeTab === tab.href ? 'page' : undefined}>
            {tab.label}
          </a>
        ))
      }
    </nav>

    <footer class="site-footer">
      <div
        class="mx-auto flex max-w-[1480px] flex-wrap items-baseline justify-between gap-x-8 gap-y-3 px-4 sm:px-8 py-6"
      >
        <p class="util m-0" style="color: var(--ink);">Built for Airmen, by Airmen.</p>
        <nav class="flex flex-wrap items-baseline gap-x-6 gap-y-2" aria-label="Site links">
          {
            footerSite.map((item) => (
              <a href={item.href} class="footer-link">
                {item.name}
              </a>
            ))
          }
        </nav>
        <p class="util m-0" style="color: var(--ink);">
          Ops Check Good <span aria-hidden="true">&nbsp;//&nbsp;</span> Est. 2024
        </p>
      </div>

      <div class="site-footer-legal">
        <div class="mx-auto max-w-[1480px] px-4 sm:px-8 pb-6">
          <p
            class="m-0 max-w-[80ch] leading-relaxed"
            style="font-size: var(--text-micro); color: var(--ink-faint);"
          >
            Unofficial personal project. Not affiliated with, endorsed by, or produced by the
            United States Air Force or the Department of Defense. Official guidance governs;
            check current instructions and your chain of command before relying on anything here.
            &copy; {year} Ops Check Good.
          </p>
        </div>
      </div>
    </footer>

    <script is:inline>
      (function () {
        var button = document.getElementById('theme-toggle');
        if (!button) return;
        var root = document.documentElement;

        function current() {
          // Light is the default, so an absent attribute means light.
          return root.getAttribute('data-theme') === 'dark' ? 'dark' : 'light';
        }
        function label() {
          // Shows the mode pressing it gives you: a moon in the light, a sun in the dark.
          var dark = current() === 'dark';
          var moon = button.querySelector('[data-icon="moon"]');
          var sun = button.querySelector('[data-icon="sun"]');
          if (moon) moon.style.display = dark ? 'none' : '';
          if (sun) sun.style.display = dark ? '' : 'none';
          button.setAttribute('aria-label', 'Switch to ' + (dark ? 'light' : 'dark') + ' mode');
        }

        button.addEventListener('click', function () {
          var next = current() === 'dark' ? 'light' : 'dark';
          root.setAttribute('data-theme', next);
          try {
            localStorage.setItem('ocg.theme', next);
          } catch (e) {
            /* Choice applies for this page view only. */
          }
          label();
        });

        label();
      })();
    </script>
  </body>
</html>
