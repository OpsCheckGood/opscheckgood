---
import '../styles/global.css';
import { tools, firstSergeant, settings, home } from '../lib/site-nav';

interface Props {
  title: string;
  description?: string;
  /**
   * Name of the tool on this page. The site is Ops Check Good; a tool such as
   * Bullet Bench sits inside it, so the header shows both. Omitted on the home
   * page, which is the site itself.
   */
  brand?: string;
  /** The tool's own tagline, shown beside its name. */
  tagline?: string;
}

const {
  title,
  /*
   * Deliberately descriptive rather than punchy.
   *
   * "Tools for Airmen." is the right thing to show a person and the wrong
   * thing to show a URL categoriser: it names no subject, so a service with no
   * entry for this domain has nothing to file it under and leaves it
   * Uncategorised -- which is what a DoD filter blocks by default. This says
   * what the site is for in terms a classifier can act on.
   */
  description = 'Free administrative and readiness tools for United States Air Force personnel: ' +
    'physical fitness assessment scoring, performance statement and award bullet formatting, ' +
    'official memorandum and letter of counseling generation, below-the-zone promotion dates, ' +
    'and a First Sergeant helping-agency directory. Runs entirely in the browser.',
  brand,
  tagline,
} = Astro.props;

const year = new Date().getFullYear();

// Everything below is derived from the one tool catalogue in lib/site-nav, so
// a tool added there appears in the header menu, the footer and the tab bar
// without a second edit.

// The header's Tools menu. First Sergeant is a collection with its own landing
// page, so it sits at the end of the list rather than inside it.
const menuTools = [...tools, firstSergeant].filter((tool) => tool.ready);

// Tools listed in the footer, alongside the reference pages a reader might
// want. Same source as the menu, so nothing here 404s.
const footerTools = menuTools;

// Site-level pages. On a phone the header nav is hidden and the tab bar has no
// room for these, so the footer is the only way to reach Settings: it is not
// decoration.
const footerSite = [
  { name: 'All tools', href: home },
  { name: firstSergeant.name, href: firstSergeant.href },
  { name: settings.name, href: settings.href },
];

// External references, for checking the shipped data against its source. Plain
// links a reader chooses to follow; the page never requests them, so hard
// constraint 1 is untouched.
const footerReference = [
  { label: 'AFPC Acronyms', href: 'https://www.afpc.af.mil/Career-Management/Acronyms/' },
  { label: 'AF e-Publishing', href: 'https://www.e-publishing.af.mil/' },
];

// The phone tab bar. Five is the most a tab bar can hold before the labels
// stop being readable, so these are the tools people actually open; the rest
// stay reachable from the Tools screen and the footer.
const tabs = [
  { label: 'Tools', href: home },
  ...tools.filter((tool) => tool.ready).map((tool) => ({ label: tool.short, href: tool.href })),
].slice(0, 5);

// Which tab is the page we are on, matched longest-first so /tools/mfr/ does
// not also light up Tools.
const path = Astro.url.pathname.replace(/\/+$/, '') || '/';
const activeTab =
  [...tabs]
    .sort((a, b) => b.href.length - a.href.length)
    .find((t) => path === t.href.replace(/\/+$/, ''))?.href ?? null;

// Site-level navigation only. A tool's own pages -- Bullet Bench's abbreviation
// lists and thesaurus, say -- belong to that tool and are reached from inside
// it. Tools carries a menu; the rest are plain links.
const nav = [
  { label: 'Tools', href: home, ready: true, menu: menuTools },
  { label: 'First Sergeant', href: firstSergeant.href, ready: true, menu: null },
  { label: 'Settings', href: settings.href, ready: true, menu: null },
];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <!--
      Colours the phone's own chrome to match the page, which is most of what
      separates "a website in a browser" from "an app". Two values so the bar
      follows the theme.
    -->
    <meta name="theme-color" content="#f1f4f8" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#0a0b0c" media="(prefers-color-scheme: dark)" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-status-bar-style" content="default" />
    <meta name="apple-mobile-web-app-title" content="Ops Check Good" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <!-- No favicon link, no web fonts, no analytics: hard constraint 1. -->
    <!--
      Runs before first paint so a stored theme choice is applied to <html>
      before anything is drawn. Inline and synchronous on purpose: an external
      or deferred script would paint the wrong theme first and then correct it.
    -->
    <script is:inline>
      (function () {
        try {
          var stored = localStorage.getItem('ocg.theme');
          if (stored === 'light' || stored === 'dark') {
            document.documentElement.setAttribute('data-theme', stored);
          }
        } catch (e) {
          /* Blocked storage: fall through to the default. */
        }
      })();
    </script>
  </head>
  <body>
    <a
      href="#main"
      class="sr-only focus:not-sr-only absolute left-2 top-2 z-10 px-3 py-2"
      style="background: var(--panel); border: 1px solid var(--rule-strong);"
    >
      Skip to content
    </a>

    <header
      class="app-bar flex flex-wrap items-center gap-x-6 gap-y-2 border-b px-3 sm:px-6 py-3 sm:py-4"
      style="border-color: var(--rule);"
    >
      {/*
        On a tool page the tool is the heading and the site is the label above
        it, rather than both competing on one line at the same size. That is
        the whole hierarchy fix in miniature: one thing leads.
      */}
      <div class="min-w-0">
        <a
          href={home}
          class="no-underline block"
          style={
            brand
              ? 'font-size: 10.5px; font-weight: 600; letter-spacing: 0.16em; text-transform: uppercase; color: var(--ink-faint);'
              : 'font-size: 17px; font-weight: 700; letter-spacing: 0.16em; color: var(--ink);'
          }
        >
          OPS CHECK GOOD
        </a>
        {
          brand && (
            <div class="flex flex-wrap items-baseline gap-x-3 gap-y-0.5">
              <span
                style="font-size: var(--text-h1); font-weight: 700; letter-spacing: -0.01em; color: var(--ink); line-height: 1.15;"
              >
                {brand}
              </span>
              {tagline && <span class="util desktop-only">{tagline}</span>}
            </div>
          )
        }
      </div>

      <nav class="ml-auto flex flex-wrap items-center gap-x-7 gap-y-2" aria-label="Site">
        <span class="desktop-only contents">
        {
          nav.map((item) =>
            !item.ready ? (
              <span
                class="util"
                title="Not built yet"
                style="letter-spacing: 0.13em; opacity: 0.5;"
              >
                {item.label}
              </span>
            ) : item.menu ? (
              /*
                The label stays a real link to the tools index, so a click or a
                keyboard Enter goes somewhere sensible; the panel is an
                additional shortcut, not the only route. Opening on hover and on
                focus-within keeps it reachable without a pointer, and costs no
                JavaScript.
              */
              <div class="nav-menu">
                <a
                  href={item.href}
                  class="util no-underline nav-menu-label"
                  style="color: var(--ink-muted); letter-spacing: 0.13em;"
                >
                  {item.label}
                  <span class="nav-menu-caret" aria-hidden="true"></span>
                </a>
                <div class="nav-menu-panel">
                  <ul class="nav-menu-list">
                    {item.menu.map((tool) => (
                      <li>
                        <a href={tool.href} class="no-underline">
                          <span class="nav-menu-name">{tool.name}</span>
                          <span class="nav-menu-note">{tool.tagline}</span>
                        </a>
                      </li>
                    ))}
                  </ul>
                </div>
              </div>
            ) : (
              <a
                href={item.href}
                class="util no-underline"
                style="color: var(--ink-muted); letter-spacing: 0.13em;"
              >
                {item.label}
              </a>
            ),
          )
        }
        </span>
        <button
          id="theme-toggle"
          type="button"
          class="util border px-2 py-1"
          style="background: var(--panel); border-color: var(--rule-strong); letter-spacing: 0.13em;"
        >
          Theme
        </button>
      </nav>
    </header>

    <main id="main" class="app-shell">
      <slot />
    </main>

    <nav class="tabbar" aria-label="Tools">
      {
        tabs.map((tab) => (
          <a href={tab.href} aria-current={activeTab === tab.href ? 'page' : undefined}>
            {tab.label}
          </a>
        ))
      }
    </nav>

    <footer class="site-footer">
      <div
        class="mx-auto grid max-w-[1560px] gap-x-8 gap-y-9 px-3 sm:px-6 py-10 sm:grid-cols-2 lg:grid-cols-4"
      >
        <div>
          <a
            href={home}
            class="no-underline"
            style="font-size: 14px; font-weight: 700; letter-spacing: 0.16em; color: var(--ink);"
          >
            OPS CHECK GOOD
          </a>
          <p class="body m-0 mt-2 max-w-[34ch]">
            Free tools for Airmen. Total force, enlisted and officer.
          </p>
          <p class="m-0 mt-3 max-w-[34ch]" style="font-size: var(--text-small); color: var(--ink-muted);">
            Everything runs in the browser. Nothing you type leaves the device.
          </p>
        </div>

        <nav aria-labelledby="footer-tools-heading">
          <h2 id="footer-tools-heading" class="util m-0">Tools</h2>
          <ul class="m-0 mt-3 list-none space-y-2 p-0">
            {
              footerTools.map((item) => (
                <li>
                  <a
                    href={item.href}
                    class="footer-link"
                  >
                    {item.name}
                  </a>
                </li>
              ))
            }
          </ul>
        </nav>

        <nav aria-labelledby="footer-site-heading">
          <h2 id="footer-site-heading" class="util m-0">Site</h2>
          <ul class="m-0 mt-3 list-none space-y-2 p-0">
            {
              footerSite.map((item) => (
                <li>
                  <a
                    href={item.href}
                    class="footer-link"
                  >
                    {item.name}
                  </a>
                </li>
              ))
            }
          </ul>
        </nav>

        <nav aria-labelledby="footer-reference-heading">
          <h2 id="footer-reference-heading" class="util m-0">Reference</h2>
          <ul class="m-0 mt-3 list-none space-y-2 p-0">
            {
              footerReference.map((item) => (
                <li>
                  <a
                    href={item.href}
                    target="_blank"
                    rel="noreferrer noopener"
                    class="footer-link"
                  >
                    {item.label} <span aria-hidden="true" style="color: var(--ink-faint);">↗</span>
                  </a>
                </li>
              ))
            }
          </ul>
        </nav>
      </div>

      {/*
        One closing bar rather than three stacked rules: the copyright, the line
        about who built it and the disclaimer are all fine print, and separating
        them with borders gave the quietest part of the page the most chrome.
      */}
      <div class="site-footer-legal">
        <div class="mx-auto flex max-w-[1560px] flex-wrap items-baseline gap-x-6 gap-y-2 px-3 sm:px-6 py-5">
          <p class="util m-0" style="letter-spacing: 0.08em;">
            &copy; {year} Ops Check Good
          </p>
          <p class="m-0" style="font-size: var(--text-small); color: var(--ink-muted);">
            Built for Airmen, by Airmen.
          </p>
          <p
            class="m-0 mt-1 basis-full max-w-[80ch] leading-relaxed"
            style="font-size: var(--text-micro); color: var(--ink-faint);"
          >
            Unofficial personal project. Not affiliated with, endorsed by, or produced by the
            United States Air Force or the Department of Defense. Official guidance governs;
            check current instructions and your chain of command before relying on anything here.
          </p>
        </div>
      </div>
    </footer>

    <script is:inline>
      (function () {
        var button = document.getElementById('theme-toggle');
        if (!button) return;
        var root = document.documentElement;

        function current() {
          // Light is the default, so an absent attribute means light.
          return root.getAttribute('data-theme') === 'dark' ? 'dark' : 'light';
        }
        function label() {
          // Names the action, not the state: pressing it gives you the other one.
          var next = current() === 'dark' ? 'Light' : 'Dark';
          button.textContent = next;
          button.setAttribute('aria-label', 'Switch to ' + next.toLowerCase() + ' mode');
        }

        button.addEventListener('click', function () {
          var next = current() === 'dark' ? 'light' : 'dark';
          root.setAttribute('data-theme', next);
          try {
            localStorage.setItem('ocg.theme', next);
          } catch (e) {
            /* Choice applies for this page view only. */
          }
          label();
        });

        label();
      })();
    </script>
  </body>
</html>
