  "meta": {
    "source": "Fluff Patrol rule set: performance statement writing checks",
    "version": "1",
    "verifiedDate": "2026-09-18",
    "sourceUrl": "",
    "status": "stub",
    "notes": "Not Air Force reference data and not transcribed from an official source, so it stays marked stub: these are configurable writing suggestions, not policy. Seeded on 2026-09-18 from the Fluff Patrol product requirements (sections 6.2, 6.4, 6.5, 6.7, 6.9 and 15): the fluff dictionary with its categories, severities and the question each one asks; the duty-description phrases; the impact, scope and result signal words behind the Action-Result-Impact-Scope indicators; the units a number should not be glued to; and the readability thresholds. Every check is deterministic pattern matching in lib/text/fluff.ts. A category carries the default severity, explanation and question for its terms, and a term may override the severity or add suggested replacements. Extend freely; it is a data edit."
  },
  "data": {
    "thresholds": {
      "sentenceWords": 35,
      "acronyms": 4,
      "semicolons": 3,
      "slashes": 3,
      "parentheticals": 2
    },
    "categories": {
      "vague-intensifier": {
        "label": "Vague intensifier",
        "severity": "medium",
        "why": "communicates strength without measuring it",
        "ask": "Can you quantify this outcome?"
      },
      "generic-success": {
        "label": "Generic success claim",
        "severity": "medium",
        "why": "asserts success without showing it",
        "ask": "What evidence demonstrates this claim?"
      },
      "empty-qualifier": {
        "label": "Empty qualifier",
        "severity": "medium",
        "why": "communicates scale without identifying it",
        "ask": "Can you name or count the items?"
      },
      "weak-contribution": {
        "label": "Weak contribution",
        "severity": "medium",
        "why": "says the member was present, not what they did",
        "ask": "What was the specific contribution?"
      },
      "duty-language": {
        "label": "Duty language",
        "severity": "medium",
        "why": "may describe an assigned responsibility rather than an accomplishment",
        "ask": "What did the member accomplish beyond the assigned duty? Consider what changed: availability, completion time, inspection result, cost avoidance, risk reduction, qualification rate, readiness measure or customer outcome."
      },
      "redundant-phrasing": {
        "label": "Redundant phrasing",
        "severity": "low",
        "why": "spends words the line does not have",
        "ask": "Consider a shorter alternative."
      },
      "overused-performance": {
        "label": "Overused performance term",
        "severity": "medium",
        "why": "names a direction of change without the change",
        "ask": "What specifically changed, and by how much?"
      },
      "unsupported-superlative": {
        "label": "Unsupported superlative",
        "severity": "high",
        "why": "claims a comparison the statement does not show",
        "ask": "Is there a defined comparison, standard or evidence?"
      },
      "filler-transition": {
        "label": "Filler transition",
        "severity": "low",
        "why": "connects clauses a bullet usually separates with a semicolon",
        "ask": "Is this transition necessary?"
      }
    },
