---
import Base from '../layouts/Base.astro';
import { tools } from '../lib/site-nav';
---

<Base title="Ops Check Good">
  <div class="mx-auto max-w-[1000px] px-3 sm:px-6 pt-10 pb-4 sm:pb-10">
    <h1 class="display m-0">Tools for Airmen.</h1>

    <p class="lede m-0 mt-5">Free to use.</p>

  </div>

  <ul class="mx-auto m-0 grid max-w-[1000px] list-none gap-3 px-3 sm:px-6 pb-12 p-0 sm:grid-cols-2">
    {
      tools.map((tool) => (
        <li class="panel card p-5 sm:p-6">
          <a href={tool.href} class="h2 no-underline block">
            {tool.name}
          </a>
          <p class="util m-0 mt-1.5" style="color: var(--accent);">{tool.tagline}</p>
          <p class="body m-0 mt-4">{tool.blurb}</p>
        </li>
      ))
    }
  </ul>
</Base>
