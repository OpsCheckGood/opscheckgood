---
import Base from '../layouts/Base.astro';
import { tools, firstSergeant } from '../lib/site-nav';

// Numbered in build order, the toolkit after the tools.
const pad = (n: number) => String(n).padStart(2, '0');
const cards = tools.filter((t) => t.ready);
const arrow =
  '<svg class="arrow" viewBox="0 0 30 18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M1 9h27M19 1l9 8-9 8"/></svg>';
---

<Base title="Ops Check Good">
  <div class="mx-auto max-w-[1480px] px-4 sm:px-8 pt-16 sm:pt-28 pb-8 sm:pb-12">
    <h1 class="display m-0">Ops Check Good</h1>
    <div class="display-rule" aria-hidden="true"></div>
  </div>

  {/* Three across on a desktop: six tools make an even 3x2. Two on a tablet, one on a phone. */}
  <ul class="mx-auto m-0 grid max-w-[1480px] list-none gap-4 px-4 sm:px-8 p-0 sm:grid-cols-2 lg:grid-cols-3">
    {
      cards.map((tool, i) => (
        <li class="tool-card card">
          <span class="util">{pad(i + 1)}</span>
          <a href={tool.href} class="h2 no-underline block" title={tool.tagline}>
            {tool.name}
          </a>
          <Fragment set:html={arrow} />
        </li>
      ))
    }
  </ul>

  <div class="mx-auto max-w-[1480px] px-4 sm:px-8 pt-10 pb-16">
    <p class="util m-0 mb-4">Toolkits</p>
    <div class="tool-card tool-card--wide card">
      <span class="util">{pad(cards.length + 1)}</span>
      <a href={firstSergeant.href} class="h2 no-underline block" title={firstSergeant.tagline}>
        First Sergeant
      </a>
      <Fragment set:html={arrow} />
    </div>
  </div>
</Base>
