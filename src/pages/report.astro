---
import Base from '../layouts/Base.astro';
import BugReport from '../components/BugReport.tsx';
import type { DataMeta } from '../lib/data/types';
import { REPO_IS_PUBLIC } from '../lib/site';

import { FORMS } from '../lib/data/forms';
import { PT_STANDARDS } from '../lib/data/pt';
import { PROMOTION_STANDARDS } from '../lib/data/promotion';
import { HQ_APPROVED, COMMON } from '../lib/data/abbreviationSets';
import { STOPWORDS, VERBS } from '../lib/data/vocab';
import { CATEGORIES, REFERENCES, SITUATIONS, NATIONAL, INSTALLATIONS } from '../lib/data/firstSergeant';
import { LOCAR_LANGUAGE, MEMO_FORMAT } from '../lib/data/memoLanguage';

/**
 * Provenance is gathered here, in the frontmatter, rather than inside the
 * island. This runs at build time, so only the `meta` blocks cross into the
 * client bundle -- importing the loaders from the component would drag every
 * scoring table, abbreviation list and installation record onto a page that
 * needs none of them.
 *
 * Deduplicated by source and version: the installation files alone number in
 * the hundreds and mostly share one origin, and a report listing that origin
 * three hundred times helps nobody.
 */
const datasets = [
  ...FORMS,
  ...PT_STANDARDS,
  ...PROMOTION_STANDARDS,
  HQ_APPROVED,
  COMMON,
  STOPWORDS,
  VERBS,
  CATEGORIES,
  REFERENCES,
  SITUATIONS,
  NATIONAL,
  ...INSTALLATIONS,
  LOCAR_LANGUAGE,
  MEMO_FORMAT,
];

const seen = new Set<string>();
const sources: DataMeta[] = [];
for (const dataset of datasets) {
  const key = `${dataset.meta.source}|${dataset.meta.version}`;
  if (seen.has(key)) continue;
  seen.add(key);
  sources.push(dataset.meta);
}
sources.sort((a, b) => a.source.localeCompare(b.source));

// Matches the routes that actually exist. "Something else" catches the site
// itself -- a broken link, a theme that will not stick -- which is a real
// report and otherwise has nowhere to go.
const tools = [
  'Bullet Bench',
  'PT Calculator',
  'BTZ Calculator',
  'MFR Generator',
  'First Sergeant Toolkit',
  'Something else',
];
---

<Base
  title="Report a bug — Ops Check Good"
  description="Report a problem with Ops Check Good. The report is built in your browser and sent nowhere."
  brand="Report a bug"
  tagline="Tell us what broke."
>
  <div class="mx-auto max-w-[900px] px-3 sm:px-6 pt-8">
    <p class="m-0 max-w-[70ch] text-[12.5px] leading-relaxed" style="color: var(--ink-muted);">
      Wrong number, broken layout, something that will not work offline — all worth
      reporting. Fill this in and the page builds a report you can {
        REPO_IS_PUBLIC ? 'paste into a GitHub issue' : 'copy and send on'
      }. Nothing is submitted from here; there is no server to submit it to.
    </p>
  </div>

  <BugReport client:load tools={tools} sources={sources} />
</Base>
